# Data and Models (Keep directory structure via .gitkeep, ignore binary data & model files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Mobility network: keep seeds/README/audit JSON; omit large GTFS + snapshots
data/mobility_network/**/snapshots/
data/mobility_network/**/failed/
data/mobility_network/**/active.json
data/mobility_network/bmtc/**/*.zip
data/mobility_network/bmtc/gtfs/
data/mobility_network/bmrcl/**/*.zip
data/mobility_network/bmrcl/gtfs/
!data/mobility_network/bmtc/audit/
!data/mobility_network/bmtc/audit/**
!data/mobility_network/bmrcl/audit/
!data/mobility_network/bmrcl/audit/**
.tmp_bmrcl_gtfs/
.tmp_bmtc_gtfs/

# IDE / OS specific files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Flutter / FVM (mobile app under src/app)
src/app/.dart_tool/
src/app/.flutter-plugins-dependencies
src/app/.packages
src/app/build/
src/app/.fvm/flutter_sdk
**/.fvm/flutter_sdk

# Prebuilt GoWise web for Cloud Run (regenerate: scripts/prepare_gowise_web.sh)
# Keep a small placeholder index.html in git; ignore the ~28MB Flutter output.
/static/gowise/**
!/static/gowise/index.html
