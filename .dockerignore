# Build context exclusions for Docker / Cloud Run source deploys.
.git
.gitignore
.gcloudignore
.venv
venv
env
ENV
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.tox
.nox
.idea
