# Environment Variables for Patchamomma Commute Agent
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Google Maps Routes API Key
# Obtain from Google Cloud Console: https://console.cloud.google.com
# Enable the "Routes API" for the project.
GOOGLE_MAPS_API_KEY=your_key_here

# Optional: Cache TTL in seconds for Maps API responses (default: 300 seconds)
MAPS_CACHE_TTL_SECONDS=300
