# Environment Variables for Patchamomma Commute Agent
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Google Maps Routes API Key
# Obtain from Google Cloud Console: https://console.cloud.google.com
# Enable the "Routes API" for the project.
GOOGLE_MAPS_API_KEY=your_key_here

# Optional: Cache TTL in seconds for Maps API responses (default: 300 seconds)
MAPS_CACHE_TTL_SECONDS=300

# Gemini / Google GenAI (ADK reasoning layer)
# If unset, the agent uses deterministic fallback (never pretends Gemini ran).
GOOGLE_GENAI_API_KEY=your_key_here
# Optional model override (default from src/agent/config.py)
# GEMINI_MODEL=gemini-2.0-flash
